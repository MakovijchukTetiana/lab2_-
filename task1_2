import numpy as np

A = np.array([
    [ 1,  2,  3,  5],
    [-2,  4,  3, -4],
    [ 3,  2, -1,  6],
    [ 4, -3,  2,  1]
], dtype=float)

B = np.array([7, 12, -3, -3], dtype=float)

def gauss_pivoting(A, B):
    n = len(B)
    # Формуємо розширену матрицю системи
    M = np.hstack([A, B.reshape(-1, 1)])

    # Прямий хід
    for i in range(n):
        # Вибір головного елемента у стовпці
        max_row = np.argmax(np.abs(M[i:n, i])) + i
        if i != max_row:
            # Перестановка рядків
            M[[i, max_row]] = M[[max_row, i]]

        # Зведення до верхньотрикутного вигляду
        for j in range(i + 1, n):
            factor = M[j, i] / M[i, i]
            M[j, i:] -= factor * M[i, i:]

    # Зворотний хід
    X = np.zeros(n)
    for i in range(n - 1, -1, -1):
        X[i] = (M[i, -1] - np.dot(M[i, i+1:n], X[i+1:n])) / M[i, i]

    return X

x_gauss = gauss_pivoting(A, B)
print("Розв'язок методом Гаусса з вибором головного елемента:")
for i, x in enumerate(x_gauss):
    print(f"x_{i+1} = {x:.4f}")
